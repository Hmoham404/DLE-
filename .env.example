MYC_LOCAL_AUTO_LOGIN=true
# Automatic access applies only to localhost in development.
MYC_STORAGE=local
# For the migrated Supabase workspace, use the existing format and namespace:
# MYC_STORAGE_FORMAT=workspace-json-v1
# MYC_STORAGE_NAMESPACE=YOUR_EXISTING_NAMESPACE
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SECRET_KEY=REPLACE_SERVER_ONLY
ENTRY_ACCESS_CODE=REPLACE_WITH_STRONG_ENTRY_CODE
MEETING_ACCESS_CODE=REPLACE_WITH_STRONG_MEETING_CODE
SESSION_SECRET=REPLACE_WITH_RANDOM_SESSION_KEY
DATA_ENCRYPTION_KEY=REPLACE_WITH_RANDOM_DURABLE_DATA_KEY
# Optional dedicated Python service:
# EXCEL_SERVICE_URL=https://your-excel-service.example
# EXCEL_SERVICE_TOKEN=REPLACE_SERVER_ONLY
